# Base de datos PostgreSQL
DATABASE_URL=jdbc:postgresql://host:5432/database_name
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password

# Puerto del servidor (Railway lo asigna automaticamente)
PORT=8080

# JWT Secret (genera uno seguro para produccion)
JWT_SECRET=tu_secret_jwt_muy_largo_y_seguro_de_al_menos_32_caracteres

# URLs para TPV
BACKEND_URL=https://tu-backend.railway.app
FRONTEND_URL=https://tu-frontend.vercel.app

# Modo mock del TPV (false en produccion)
TPV_MOCK_MODE=false

# CORS origenes permitidos (separados por coma)
CORS_ORIGINS=https://tu-frontend.vercel.app

# TPV API Key (del Grupo 19)
TPV_API_KEY=tu_api_key_del_tpv
